# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="LeadPulse CRM"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended; works with local Docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/leadpulse

# SQLite fallback (optional for local-only usage)
# DATABASE_URL=sqlite:///./leadpulse.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Seed Admin ────────────────────────────────────────────────────────────────
# Created on first startup if no users exist
FIRST_ADMIN_EMAIL=admin@leadpulse.com
FIRST_ADMIN_PASSWORD=Admin@123
FIRST_ADMIN_NAME=System Admin

# ── Attendance ────────────────────────────────────────────────────────────────
COMPANY_TIMEZONE=Asia/Kolkata
